# Configurações sensíveis - NUNCA COMITAR!
loja/abacatepay_config.php
loja/*_config.php
!loja/abacatepay_config.example.php

# Logs do sistema
loja/abacatepay_webhook_log.txt
loja/*_webhook_log.txt
*.log

# Arquivos temporários
*.tmp
*.bak
*.swp
*~

# Fotos de produtos (muito pesado para Git)
produto/fotos/*.jpg
produto/fotos/*.jpeg
produto/fotos/*.png
produto/fotos/*.gif
produto/fotos/*.webp

# Manter estrutura de pastas
!produto/fotos/.gitkeep
!produto/fotos/README.md

# IDEs e Editores
.vscode/
.idea/
*.sublime-*
*.code-workspace

# Sistema Operacional
.DS_Store
Thumbs.db
desktop.ini

# Backups de banco de dados
*.sql.bak
backup_*.sql

# Arquivos do EasyPHP
.eds-*
php_errors.log

